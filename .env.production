# Production build target — read automatically by `vite build`.
#
# This file exists because passing these on the command line silently failed:
# a shell export lives for one invocation, so the first `npm run build` produced
# a correct bundle and every later one fell back to `.env` — which still points
# at the old hosted Supabase project. Three deploys shipped a frontend that
# talked to the wrong database, and the only symptom was that a password changed
# on the VPS did not work in the browser.
#
# Committed on purpose. Every value here is public by construction: the anon key
# is designed to ship inside the browser bundle and is bounded by RLS, and both
# URLs are visible in any network trace. The service-role key is NOT here and
# must never be — it bypasses every RLS policy.
#
# `.env` stays gitignored and is for local development.

VITE_SUPABASE_URL=https://api.elprofessor.de
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg5MDUyMjE4LCJleHAiOjIxMDQ0MTIyMTh9.Rewe2DCIjfB5YkchNaJGnP6QtQlA54pcUMtPmypm7c4
VITE_APP_URL=https://app.elprofessor.de
