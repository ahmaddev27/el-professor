# e2e/setup-staging.sh writes these into e2e/.env.local (gitignored) and
# generates the passwords. Never commit real values.
E2E_BASE_URL=https://app.elprofessor.eu
E2E_API_URL=https://api-staging.elprofessor.eu
# Staging's anon key, copied from the host by setup. Public: it ships in the web bundle.
E2E_ANON_KEY=
E2E_SSH_HOST=elprofessor
E2E_MAILPIT_URL=http://127.0.0.1:18025
E2E_STAGING_USER=e2e
E2E_STAGING_PASS=
E2E_MAILPIT_USER=e2e
E2E_MAILPIT_PASS=
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=
# The seeded password-reset accounts, comma separated. forgot-password spends one
# of five hourly codes per address, so global setup rotates over these instead of
# sharing the admin; playwright.config.ts requires the key.
E2E_RESET_EMAILS=e2e-reset-1@example.com,e2e-reset-2@example.com,e2e-reset-3@example.com,e2e-reset-4@example.com,e2e-reset-5@example.com,e2e-reset-6@example.com
