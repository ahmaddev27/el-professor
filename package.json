{
  "name": "el-professor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/typecheck-ratchet.mjs && node scripts/style-ratchet.mjs && vitest run && vite build && node scripts/build-email-templates.mjs",
    "build:novalidate": "vite build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json",
    "typecheck:update": "node scripts/typecheck-ratchet.mjs --update",
    "styles": "node scripts/style-ratchet.mjs",
    "styles:update": "node scripts/style-ratchet.mjs --update",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node scripts/rls-test.mjs",
    "harness": "vite --config design-harness/vite.config.ts",
    "harness:capture": "node design-harness/capture.mjs",
    "harness:flows": "node design-harness/flows-batch1.mjs",
    "harness:analysis:capture": "node design-harness/capture.mjs --batch analysis",
    "harness:analysis:flows": "node design-harness/flows-analysis.mjs",
    "harness:batch4": "vite --config design-harness/batch4/vite.config.ts",
    "harness:batch4:capture": "node design-harness/batch4/capture.mjs",
    "harness:batch4:flows": "node design-harness/flows-batch4.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.57.4",
    "@types/node": "^24.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.6.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.4.35",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
