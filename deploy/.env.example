# Copy to deploy/.env and fill in every value. deploy/.env is gitignored.
#
# Generate the secrets:
#   POSTGRES_PASSWORD        openssl rand -base64 32
#   JWT_SECRET               openssl rand -base64 48     (must be >= 32 chars)
#   REALTIME_ENC_KEY         openssl rand -hex 16        (exactly 32 hex chars)
#   REALTIME_SECRET_KEY_BASE openssl rand -base64 48
#
# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET. Mint them at
# https://supabase.com/docs/guides/self-hosting#api-keys (the generator runs in
# the browser; nothing leaves the page), or with any JWT tool using:
#   anon:         { "role": "anon",         "iss": "supabase", "iat": ..., "exp": ... }
#   service_role: { "role": "service_role", "iss": "supabase", "iat": ..., "exp": ... }
#
# SERVICE_ROLE_KEY bypasses every RLS policy. It belongs only on the server, in
# the edge functions. It must never reach the browser bundle.

# ── Core ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600

ANON_KEY=
SERVICE_ROLE_KEY=

# ── URLs ────────────────────────────────────────────────────────────────────
# PUBLIC_URL is where Kong is reachable — the value that becomes
# VITE_SUPABASE_URL in the frontend build.
PUBLIC_URL=https://api.your-domain.de
# APP_URL is where the SPA is served. Auth redirect links are built from it.
APP_URL=https://app.your-domain.de

# ── Mail ────────────────────────────────────────────────────────────────────
# Required. Password reset and user invites go through here; without it a
# locked-out user has no way back in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=noreply@your-domain.de
SMTP_SENDER_NAME=El-Professor

# ── Google sign-in ──────────────────────────────────────────────────────────
# The login screen offers "Mit Google anmelden". Leave disabled until the
# redirect URI ${PUBLIC_URL}/auth/v1/callback is registered in Google Cloud.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ── Realtime ────────────────────────────────────────────────────────────────
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# ── Signup ──────────────────────────────────────────────────────────────────
# Companies are created by the company-signup function, which uses the service
# role. Direct GoTrue signup is not part of any flow.
DISABLE_SIGNUP=false
