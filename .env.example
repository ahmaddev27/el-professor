# Supabase — both required.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public app URL — baked into auth email redirect links (password reset, invite).
# Set this to the real production domain, or reset emails point at localhost.
# Falls back to window.location.origin when blank, which is correct for local dev.
VITE_APP_URL=https://app.yourdomain.com
