# API Configuration - Update with your Hostinger backend URL
VITE_API_URL=https://yourdomain.com/backend

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public app URL — used for auth email redirect links (password reset, invite).
# Set to your real production domain so reset emails don't point to localhost.
# Example: https://app.yourdomain.com
VITE_APP_URL=https://app.yourdomain.com
