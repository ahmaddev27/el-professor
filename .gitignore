# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

# Vite temp artifacts
vite.config.ts.timestamp-*.mjs

# Schema dumps produced during the VPS migration (may contain structure only,
# but are large and machine-generated — never a source of truth in git).
schema-prod.sql
schema-chain.sql

# Local deployment secrets
deploy/.env

# Generated per environment into dist/ by scripts/build-email-templates.mjs.
public/email-templates/*.html

# Mailpit UI login for staging (bcrypt), provisioned on the host by
# deploy/set-mailpit-password.sh. Never committed.
deploy/mailpit-ui-auth

# Staging mail relay settings, holding production's Resend key. Written on the
# host by deploy/set-staging-mail-relay.sh. Never committed.
deploy/mailpit-relay.yml

# End-to-end test output (e2e/). Credentials live in e2e/.env.local, covered by *.local.
e2e/test-results
e2e/playwright-report

# Worktrees Claude Code agents create for parallel work.
.claude/worktrees/

# A reference file the owner shares into the repo root; never part of the product.
FleetBook_*.html
bash.exe.stackdump
# Spreadsheets dropped in the repo root while testing an import or an export.
# Three of them (uber.xlsx, a generated SIMULIERT_ workbook and a scratch file)
# were swept into a commit by `git add -A` on 22.10.2026 and reached staging:
# 898 KB of a real customer's ride export and a simulated Fahrtenbuch, neither
# of which belongs in version control. Put a sample under tests/fixtures/ with
# a name that says what it is, or keep it outside the checkout.
/*.xlsx
SIMULIERT_*.xlsx
